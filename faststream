def get_lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def find_available_port(base_port, max_attempts=50, is_explicit=False):
    for offset in range(max_attempts):
        candidate_port = base_port + offset
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(("0.0.0.0", candidate_port))
            sock.close()
            return candidate_port
        except OSError:
            if is_explicit:
                print(f"❌ Error: El puerto especificado {candidate_port} ya está en uso.")
                sys.exit(1)
            continue
    print(f"❌ Error: No se encontró ningún puerto libre en el rango {base_port}-{base_port+max_attempts}.")
    sys.exit(1)

# Pure Python Reed-Solomon GF(256) Terminal QR Code Engine (Canonical Proven Implementation)
class PureTerminalQR:
    EXP = [1] * 512
    LOG = [0] * 256
    _init_done = False

    @classmethod
    def _init(cls):
        if cls._init_done: return
        x = 1
        for i in range(255):
            cls.EXP[i] = x
            cls.EXP[i + 255] = x
            cls.LOG[x] = i
            x = (x << 1) ^ (0x11d if x & 0x80 else 0)
        cls.LOG[0] = 0
        cls._init_done = True

    @classmethod
    def gmul(cls, a, b):
        if a == 0 or b == 0: return 0
        return cls.EXP[cls.LOG[a] + cls.LOG[b]]

    @classmethod
    def rs_poly(cls, n):
        g = [1]
        for i in range(n):
            g = cls.poly_mul(g, [1, cls.EXP[i]])
        return g

    @classmethod
    def poly_mul(cls, p, q):
        r = [0] * (len(p) + len(q) - 1)
        for i, a in enumerate(p):
            for j, b in enumerate(q):
                r[i + j] ^= cls.gmul(a, b)
        return r

    @classmethod
    def rs_encode(cls, data, nsym):
        cls._init()
        gen = cls.rs_poly(nsym)
        res = [0] * (len(data) + nsym)
        res[:len(data)] = data
        for i in range(len(data)):
            coef = res[i]
            if coef != 0:
                for j in range(len(gen)):
                    res[i + j] ^= cls.gmul(gen[j], coef)
        return list(data) + res[len(data):]

    @classmethod
    def generate(cls, text):
        cls._init()
        data_bytes = text.encode('utf-8')
        length = len(data_bytes)
        
        if length <= 17:
            ver = 1; size = 21; total_cw = 26; ec_cw = 7
        elif length <= 32:
            ver = 2; size = 25; total_cw = 44; ec_cw = 10
        elif length <= 53:
            ver = 3; size = 29; total_cw = 70; ec_cw = 15
        else:
            ver = 4; size = 33; total_cw = 100; ec_cw = 20

        data_cap = total_cw - ec_cw
        bits = [0, 1, 0, 0]
        for i in range(7, -1, -1):
            bits.append((length >> i) & 1)
        for b in data_bytes:
            for i in range(7, -1, -1):
                bits.append((b >> i) & 1)
        bits.extend([0] * min(4, data_cap * 8 - len(bits)))
        while len(bits) % 8 != 0:
            bits.append(0)
        pad = [0xEC, 0x11]
        pidx = 0
        while len(bits) < data_cap * 8:
            pb = pad[pidx % 2]
            for i in range(7, -1, -1):
                bits.append((pb >> i) & 1)
            pidx += 1

        raw_cw = []
        for i in range(0, len(bits), 8):
            val = 0
            for j in range(8):
                val = (val << 1) | bits[i + j]
            raw_cw.append(val)

        all_cw = cls.rs_encode(raw_cw, ec_cw)
        all_bits = []
        for cw in all_cw:
            for i in range(7, -1, -1):
                all_bits.append((cw >> i) & 1)

        matrix = [[None] * size for _ in range(size)]
        reserved = [[False] * size for _ in range(size)]

        def set_val(r, c, v):
            matrix[r][c] = v
            reserved[r][c] = True

        def add_finder(tr, lc):
            for r in range(7):
                for c in range(7):
                    if r in (0, 6) or c in (0, 6) or (2 <= r <= 4 and 2 <= c <= 4):
                        set_val(tr + r, lc + c, 1)
                    else:
                        set_val(tr + r, lc + c, 0)
            for r in range(-1, 8):
                for c in range(-1, 8):
                    rr, cc = tr + r, lc + c
                    if 0 <= rr < size and 0 <= cc < size and not reserved[rr][cc]:
                        set_val(rr, cc, 0)

        add_finder(0, 0)
        add_finder(0, size - 7)
        add_finder(size - 7, 0)

        if ver >= 2:
            align_pos = {2: 18, 3: 22, 4: 26}[ver]
            for r in range(-2, 3):
                for c in range(-2, 3):
                    rr, cc = align_pos + r, align_pos + c
                    if not reserved[rr][cc]:
                        if r in (-2, 2) or c in (-2, 2) or (r == 0 and c == 0):
                            set_val(rr, cc, 1)
                        else:
                            set_val(rr, cc, 0)

        for i in range(size):
            if not reserved[6][i]: set_val(6, i, 1 if i % 2 == 0 else 0)
            if not reserved[i][6]: set_val(i, 6, 1 if i % 2 == 0 else 0)

        set_val(size - 8, 8, 1)

        for i in range(9):
            if not reserved[8][i]: reserved[8][i] = True
            if not reserved[i][8]: reserved[8][i] = True
        for i in range(size - 8, size):
            if not reserved[8][i]: reserved[8][i] = True
            if not reserved[i][8]: reserved[i][8] = True

        bit_idx = 0
        r, c = size - 1, size - 1
        dir_up = True
        while c > 0:
            if c == 6: c -= 1
            for i in range(size):
                curr_r = (size - 1 - i) if dir_up else i
                for col_offset in [0, -1]:
                    curr_c = c + col_offset
                    if not reserved[curr_r][curr_c]:
                        bit_val = all_bits[bit_idx] if bit_idx < len(all_bits) else 0
                        if (curr_r + curr_c) % 2 == 0:
                            bit_val ^= 1
                        matrix[curr_r][curr_c] = bit_val
                        bit_idx += 1
            c -= 2
            dir_up = not dir_up

        fmt_bits = [1,1,1,0,1,1,1,1,1,0,0,0,1,0,0]
        pos_tl = [(8,0),(8,1),(8,2),(8,3),(8,4),(8,5),(8,7),(8,8),(7,8),(5,8),(4,8),(3,8),(2,8),(1,8),(0,8)]
        for (fr, fc), fb in zip(pos_tl, fmt_bits):
            matrix[fr][fc] = fb
        for idx in range(7):
            matrix[size - 1 - idx][8] = fmt_bits[idx]
        for idx in range(8):
            matrix[8][size - 8 + idx] = fmt_bits[7 + idx]

        border = 2
        full_size = size + 2 * border
        grid = [[0] * full_size for _ in range(full_size)]
        for r in range(size):
            for c in range(size):
                grid[r + border][c + border] = matrix[r][c] or 0

        lines = []
        for r in range(0, full_size, 2):
            line = "  "
            for c in range(full_size):
                top = grid[r][c]
                bot = grid[r + 1][c] if r + 1 < full_size else 0
                if top == 1 and bot == 1:
                    line += " "
                elif top == 1 and bot == 0:
                    line += "▄"
                elif top == 0 and bot == 1:
                    line += "▀"
                else:
                    line += "█"
            lines.append(line)
        return "\n".join(lines)

