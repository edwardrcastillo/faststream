import sys, os, socket, http.server, socketserver, argparse, urllib.parse, urllib.request, json, subprocess, re, struct

CONFIG_DIR = os.path.expanduser("~/.config/faststream")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
DEFAULT_FALLBACK_KEY = "a07e22bc18f5cb106bfe4cc1f83ad8ed"

def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)

def get_tmdb_api_key(cli_key=None):
    if cli_key:
        return cli_key.strip()
    if os.environ.get("TMDB_API_KEY"):
        return os.environ.get("TMDB_API_KEY").strip()
    cfg = load_config()
    if cfg.get("tmdb_api_key"):
        return cfg.get("tmdb_api_key").strip()
    return DEFAULT_FALLBACK_KEY

def get_lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

VIDEO_EXTS = {'.mp4', '.mkv', '.avi', '.mov', '.ts', '.m4v', '.webm'}

def clean_search_title(fname):
    name = os.path.splitext(os.path.basename(fname))[0]
    tmdb_match = re.search(r'\[tmdbid-(\d+)\]', name)
    tmdb_id = tmdb_match.group(1) if tmdb_match else None
    
    y_match = re.search(r'\((\d{4})\)', name)
    year = y_match.group(1) if y_match else None
    
    clean = re.sub(r'\[.*?\]|\(.*?\)', '', name)
    clean = re.sub(r'1080p|720p|480p|x264|x265|hevc|bluray|dvdrip|web-dl|webrip|latino|dual|castellano', '', clean, flags=re.I)
    clean = re.sub(r'[-_.]', ' ', clean).strip()
    clean = re.sub(r'\s+', ' ', clean)
    return clean, year, tmdb_id

def query_tmdb_search(query, year=None, api_key=None):
    key = api_key or get_tmdb_api_key()
    if not key or not query:
        return []
    try:
        url = f"https://api.themoviedb.org/3/search/movie?api_key={key}&query={urllib.parse.quote(query)}&language=es-MX"
        if year:
            url += f"&year={year}"
        req = urllib.request.Request(url, headers={"User-Agent": "FastStream/1.4"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode())
            results = data.get("results", [])
            items = []
            for m in results[:10]:
                items.append({
                    "id": m.get("id"),
                    "title": m.get("title"),
                    "original_title": m.get("original_title"),
                    "year": m.get("release_date", "")[:4] if m.get("release_date") else "N/A",
                    "overview": m.get("overview") or "Sin sinopsis disponible.",
                    "poster_url": f"https://image.tmdb.org/t/p/w300{m.get('poster_path')}" if m.get("poster_path") else None,
                    "backdrop_url": f"https://image.tmdb.org/t/p/original{m.get('backdrop_path')}" if m.get("backdrop_path") else None,
                    "rating": f"{m.get('vote_average'):.1f}" if m.get("vote_average") else "N/A"
                })
            return items
    except Exception:
        return []

def fetch_tmdb_by_id(tmdb_id, api_key=None):
    key = api_key or get_tmdb_api_key()
    try:
        url = f"https://api.themoviedb.org/3/movie/{tmdb_id}?api_key={key}&language=es-MX"
        req = urllib.request.Request(url, headers={"User-Agent": "FastStream/1.4"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            m = json.loads(resp.read().decode())
            return {
                "tmdb_id": m.get("id"),
                "title": m.get("title"),
                "overview": m.get("overview"),
                "release_date": m.get("release_date"),
                "vote_average": m.get("vote_average"),
                "poster_url": f"https://image.tmdb.org/t/p/w500{m.get('poster_path')}" if m.get("poster_path") else None,
                "backdrop_url": f"https://image.tmdb.org/t/p/original{m.get('backdrop_path')}" if m.get("backdrop_path") else None
            }
    except Exception:
        return {}

def parse_mp4_atoms_pure_python(file_path):
    """Parser ligero nativo de átomos MP4 en Python puro (sin ffprobe)."""
    duration_str = None
    try:
        with open(file_path, "rb") as f:
            while True:
                header = f.read(8)
                if len(header) < 8:
                    break
                size, atom_type = struct.unpack(">I4s", header)
                if size == 1: # 64-bit large size
                    size = struct.unpack(">Q", f.read(8))[0] - 8
                if size == 0:
                    break
                if atom_type == b'moov':
                    # Leer dentro de moov
                    moov_data = f.read(size - 8)
                    mvhd_idx = moov_data.find(b'mvhd')
                    if mvhd_idx != -1:
                        # mvhd atom
                        v = moov_data[mvhd_idx+4]
                        if v == 0:
                            timescale, duration = struct.unpack(">II", moov_data[mvhd_idx+16:mvhd_idx+24])
                        else:
                            timescale, duration = struct.unpack(">IQ", moov_data[mvhd_idx+24:mvhd_idx+36])
                        if timescale > 0 and duration > 0:
                            sec = duration / timescale
                            hrs = int(sec // 3600)
                            mins = int((sec % 3600) // 60)
                            duration_str = f"{hrs}h {mins}m" if hrs > 0 else f"{mins} min"
                    break
                else:
                    f.seek(size - 8, os.SEEK_CUR)
    except Exception:
        pass
    return duration_str

def get_file_metadata(file_path, api_key=None):
    raw_fname = os.path.basename(file_path)
    clean_t, yr, tmdb_id = clean_search_title(raw_fname)
    
    title = clean_t
    duration_str = "N/A"
    res_str = "Video HD"
    v_codec = "Nativo"
    a_summary = "Stereo"
    tags_desc = ""
    tags_date = None
    
    # 1. Intentar con ffprobe si está instalado
    ffprobe_available = False
    try:
        cmd = ['ffprobe', '-v', 'error', '-show_format', '-show_streams', '-of', 'json', file_path]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
        if res.returncode == 0:
            ffprobe_available = True
            data = json.loads(res.stdout)
            fmt = data.get('format', {})
            duration_sec = float(fmt.get('duration', 0))
            tags = fmt.get('tags', {})
            title = tags.get('title') or title
            tags_desc = tags.get('description') or tags.get('comment') or ""
            tags_date = tags.get('date')
            
            if duration_sec:
                hrs = int(duration_sec // 3600)
                mins = int((duration_sec % 3600) // 60)
                duration_str = f"{hrs}h {mins}m" if hrs > 0 else f"{mins} min"
            
            v_stream = next((s for s in data.get('streams', []) if s.get('codec_type') == 'video'), None)
            if v_stream:
                res_str = f"{v_stream.get('width')}x{v_stream.get('height')}"
                v_codec = v_stream.get('codec_name', 'H.264').upper()
            
            a_streams = [s for s in data.get('streams', []) if s.get('codec_type') == 'audio']
            if a_streams:
                a_summary = ", ".join([f"{a.get('tags', {}).get('language', 'spa').upper()}" for a in a_streams])
    except Exception:
        pass
    
    # 2. Si ffprobe no está instalado, intentar parsing nativo de átomos MP4 en Python puro
    if not ffprobe_available and file_path.lower().endswith('.mp4'):
        parsed_dur = parse_mp4_atoms_pure_python(file_path)
        if parsed_dur:
            duration_str = parsed_dur
    
    # 3. Enriquecer con TMDB
    tmdb = {}
    if tmdb_id:
        tmdb = fetch_tmdb_by_id(tmdb_id, api_key)
    if not tmdb:
        search_year = yr or tags_date
        search_res = query_tmdb_search(clean_t, search_year, api_key)
        if search_res:
            tmdb = search_res[0]
            tmdb['poster_url'] = f"https://image.tmdb.org/t/p/w500{tmdb['poster_url'].split('/')[-1]}" if tmdb.get('poster_url') else None
    
    return {
        'title': tmdb.get('title') or title,
        'filename': raw_fname,
        'clean_title': clean_t,
        'duration': duration_str,
        'resolution': res_str,
        'codec': v_codec,
        'audio': a_summary,
        'size_mb': f"{os.path.getsize(file_path)/(1024*1024):.1f} MB",
        'description': tmdb.get('overview') or tags_desc or "Sin descripción disponible.",
        'poster_url': tmdb.get('poster_url'),
        'backdrop_url': tmdb.get('backdrop_url'),
        'rating': f"⭐ {tmdb.get('vote_average'):.1f}/10" if tmdb.get('vote_average') else (f"⭐ {tmdb.get('rating')}/10" if tmdb.get('rating') and tmdb.get('rating') != "N/A" else None),
        'year': tmdb.get('release_date', '')[:4] if tmdb.get('release_date') else (tmdb.get('year') or yr),
        'tmdb_id': tmdb.get('id') or tmdb_id
    }

