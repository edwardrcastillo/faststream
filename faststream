def run_faststream(target, requested_port=None, api_key=None, verbose=False):
    abs_target = os.path.abspath(target)
    if not os.path.exists(abs_target):
        print(f"❌ Error: La ruta '{target}' no existe.")
        sys.exit(1)
        
    is_dir = os.path.isdir(abs_target)
    file_list = []
    current_file = abs_target
    catalog_items = []
    
    if is_dir:
        print(f"📂 Escaneando colección de videos en '{abs_target}'...")
        for root, _, files in os.walk(abs_target):
            for f in sorted(files):
                ext = os.path.splitext(f)[1].lower()
                if ext in VIDEO_EXTS and not f.startswith('.'):
                    file_list.append(os.path.join(root, f))
        if not file_list:
            print(f"❌ No se encontraron archivos de video en '{target}'.")
            sys.exit(1)
            
        total_files = len(file_list)
        print(f"🔍 Obteniendo metadatos para {total_files} videos en paralelo:")
        catalog_items = [None] * total_files
        completed_count = 0
        
        def fetch_meta_for_index(idx, fpath):
            return idx, get_file_metadata(fpath, api_key)
            
        with ThreadPoolExecutor(max_workers=20) as executor:
            future_to_idx = {executor.submit(fetch_meta_for_index, i, f): (i, f) for i, f in enumerate(file_list)}
            for future in as_completed(future_to_idx):
                idx, fpath = future_to_idx[future]
                try:
                    i, m = future.result()
                    catalog_items[i] = m
                    completed_count += 1
                    print_progress_bar(completed_count, total_files, m.get('title', os.path.basename(fpath)))
                except Exception:
                    completed_count += 1
                    catalog_items[idx] = get_file_metadata(fpath, api_key)
                    print_progress_bar(completed_count, total_files, os.path.basename(fpath))

        current_file = file_list[0]
        meta = catalog_items[0]
    else:
        print("🔍 Consultando metadatos iniciales...")
        meta = get_file_metadata(abs_target, api_key)

    shutdown_lock = threading.Lock()
    is_shutting_down = False

    class FastStreamHandler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args):
            if verbose:
                super().log_message(format, *args)
            else:
                req_line = args[0] if args else ""
                if "POST /api" in req_line or "GET /api" in req_line:
                    super().log_message(format, *args)

        def do_HEAD(self):
            if self.path == "/favicon.ico":
                self.send_response(204)
                self.end_headers()
                return
            if self.path.startswith("/video"):
                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Accept-Ranges", "bytes")
                self.end_headers()
            else:
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()

        def do_GET(self):
            nonlocal current_file, abs_target, meta, catalog_items, file_list
            parsed = urllib.parse.urlparse(self.path)
            
            if parsed.path == "/favicon.ico":
                self.send_response(204)
                self.end_headers()
                return

            if parsed.path == "/api/search":
                qs = urllib.parse.parse_qs(parsed.query)
                q = qs.get("q", [""])[0]
                y = qs.get("year", [""])[0]
                results = query_tmdb_search(q, y, api_key)
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.end_headers()
                try:
                    self.wfile.write(json.dumps(results, ensure_ascii=False).encode("utf-8"))
                except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                    pass
                return

            # Vista Principal
            if parsed.path == "/" or parsed.path == "/index.html":
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                if is_dir:
                    html_content = generate_catalog_html(abs_target, catalog_items)
                else:
                    meta = get_file_metadata(current_file, api_key)
                    html_content = generate_player_html(current_file, meta, is_dir=False)
                try:
                    self.wfile.write(html_content.encode("utf-8"))
                except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                    pass
                return
                
            # Reproducción de un elemento específico
            if parsed.path == "/play":
                query = urllib.parse.parse_qs(parsed.query)
                idx = int(query.get("index", ["0"])[0])
                if 0 <= idx < len(file_list):
                    current_file = file_list[idx]
                    meta = catalog_items[idx] if idx < len(catalog_items) and catalog_items[idx] else get_file_metadata(current_file, api_key)
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                html_content = generate_player_html(current_file, meta, is_dir=is_dir, file_list=file_list, current_idx=idx)
                try:
                    self.wfile.write(html_content.encode("utf-8"))
                except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                    pass
                return

            # Streaming HTTP 206 Partial Content
            if parsed.path.startswith("/video"):
                # Permitir reproducir por index si se proporciona
                query = urllib.parse.parse_qs(parsed.query)
                if "index" in query:
                    idx = int(query.get("index", ["0"])[0])
                    if 0 <= idx < len(file_list):
                        video_target = file_list[idx]
                    else:
                        video_target = current_file
                else:
                    video_target = current_file

                try:
                    file_size = os.path.getsize(video_target)
                except Exception:
                    self.send_error(404, "Archivo de video no encontrado")
                    return

                range_header = self.headers.get("Range")
                if range_header:
                    range_match = re.match(r"bytes=(\d+)-(\d*)", range_header)
                    if range_match:
                        start = int(range_match.group(1))
                        end = int(range_match.group(2)) if range_match.group(2) else file_size - 1
                        if start >= file_size:
                            self.send_error(416, "Requested Range Not Satisfiable")
                            return
                        end = min(end, file_size - 1)
                        content_length = end - start + 1

                        self.send_response(206)
                        self.send_header("Content-Type", "video/mp4")
                        self.send_header("Content-Range", f"bytes {start}-{end}/{file_size}")
                        self.send_header("Content-Length", str(content_length))
                        self.send_header("Accept-Ranges", "bytes")
                        self.end_headers()

                        try:
                            with open(video_target, "rb") as f:
                                f.seek(start)
                                remaining = content_length
                                while remaining > 0:
                                    chunk_size = min(remaining, 64 * 1024)
                                    data = f.read(chunk_size)
                                    if not data: break
                                    self.wfile.write(data)
                                    remaining -= len(data)
                        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                            pass
                        return

                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Content-Length", str(file_size))
                self.send_header("Accept-Ranges", "bytes")
                self.end_headers()

                try:
                    with open(video_target, "rb") as f:
                        while True:
                            data = f.read(64 * 1024)
                            if not data: break
                            self.wfile.write(data)
                except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                    pass
                return

            self.send_error(404)

        def do_POST(self):
            nonlocal current_file, abs_target, meta, is_shutting_down, file_list, catalog_items
            parsed = urllib.parse.urlparse(self.path)

            if parsed.path == "/api/shutdown":
                with shutdown_lock:
                    if is_shutting_down: return
                    is_shutting_down = True
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.end_headers()
                self.wfile.write(json.dumps({"success": True}).encode("utf-8"))
                def kill_server():
                    time.sleep(0.3)
                    print("\n🛑 Apagado remoto solicitado desde el navegador. Servidor detenido.")
                    os._exit(0)
                threading.Thread(target=kill_server).start()
                return

            if parsed.path == "/api/rename":
                try:
                    query = urllib.parse.parse_qs(parsed.query)
                    target_idx = None
                    if "index" in query:
                        target_idx = int(query.get("index", ["0"])[0])

                    content_length = int(self.headers.get('Content-Length', 0))
                    body = self.rfile.read(content_length).decode('utf-8')
                    data = json.loads(body)
                    
                    tmdb_id = data.get("tmdb_id")
                    title = data.get("title")
                    year = data.get("year")
                    
                    file_to_rename = current_file
                    if is_dir and target_idx is not None and 0 <= target_idx < len(file_list):
                        file_to_rename = file_list[target_idx]

                    clean_t = re.sub(r'[/\\?%*:|"<>.]', '', title).strip()
                    ext = os.path.splitext(file_to_rename)[1]
                    parent_dir = os.path.dirname(file_to_rename)
                    
                    new_filename = f"{clean_t} ({year}) [tmdbid-{tmdb_id}]{ext}"
                    new_full_path = os.path.join(parent_dir, new_filename)
                    
                    print(f"\n🏷️ Renombrando archivo físico a estándar Jellyfin:")
                    print(f"   Origen:  {file_to_rename}")
                    print(f"   Destino: {new_full_path}")
                    
                    os.rename(file_to_rename, new_full_path)
                    current_file = new_full_path
                    if not is_dir:
                        abs_target = new_full_path
                    else:
                        if target_idx is not None and 0 <= target_idx < len(file_list):
                            file_list[target_idx] = new_full_path
                    
                    # Actualizar metadatos en vivo
                    new_meta = get_file_metadata(new_full_path, api_key)
                    meta = new_meta
                    if is_dir and target_idx is not None and 0 <= target_idx < len(catalog_items):
                        catalog_items[target_idx] = new_meta
                    
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json; charset=utf-8")
                    self.end_headers()
                    self.wfile.write(json.dumps({
                        "success": True,
                        "new_filename": new_filename,
                        "new_path": new_full_path
                    }).encode('utf-8'))
                except Exception as e:
                    self.send_response(500)
                    self.send_header("Content-Type", "application/json; charset=utf-8")
                    self.end_headers()
                    self.wfile.write(json.dumps({"success": False, "error": str(e)}).encode('utf-8'))
                return

            self.send_error(404)

    class SilentTCPServer(socketserver.TCPServer):
        allow_reuse_address = True
        
        def handle_error(self, request, client_address):
            exc_type, exc_val, _ = sys.exc_info()
            if exc_type in (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                return
            super().handle_error(request, client_address)

    is_explicit = requested_port is not None
    base_port = requested_port or 8090
    final_port = find_available_port(base_port, max_attempts=50, is_explicit=is_explicit)
    
    if not is_explicit and final_port != 8090:
        print(f"\n⚡ Puerto base 8090 ocupado por otra instancia. Asignando automáticamente puerto libre: {final_port}")

    lan_ip = get_lan_ip()
    stream_url = f"http://{lan_ip}:{final_port}/"
    
    print("\n" + "="*70)
    print(f"⚡ FASTSTREAM v2.0.2 - STREAMING & GLASSMORPHIC MEDIA HUB")
    print("="*70)
    if is_dir:
        print(f"📁 Modo:     Catálogo de Carpeta ({len(file_list)} videos)")
        print(f"📂 Ruta:     {abs_target}")
    else:
        print(f"🎬 Título:   {meta['title']} ({meta.get('year') or 'N/A'})")
        print(f"📂 Archivo:  {abs_target}")
    print(f"🌐 URL Web:  \033[1;32m{stream_url}\033[0m")
    
    print_qr_terminal(stream_url)
    
    print("="*70)
    print("💡 Presiona Ctrl + C o pulsa '🛑 Apagar' en el navegador para detener.\n")
    
    try:
        with SilentTCPServer(("0.0.0.0", final_port), FastStreamHandler) as httpd:
            httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n🛑 Servidor FastStream detenido correctamente.")
        sys.exit(0)

def main():
    parser = argparse.ArgumentParser(description="⚡ FastStream - Transmite cualquier video o carpeta por HTTP al instante en tu red local.")
    parser.add_argument("target", nargs="?", help="Ruta al archivo de video o carpeta a transmitir.")
    parser.add_argument("-p", "--port", type=int, default=None, help="Puerto HTTP específico (por defecto: 8090 o el siguiente puerto libre).")
    parser.add_argument("-v", "--verbose", action="store_true", help="Mostrar logs detallados de todas las peticiones HTTP.")
    parser.add_argument("--tmdb-key", help="Clave de API de TheMovieDB a usar.")
    parser.add_argument("--set-tmdb-key", help="Guardar tu clave de API de TMDB en ~/.config/faststream/config.json permanentemente.")
    args = parser.parse_args()
    
    if args.set_tmdb_key:
        save_config({"tmdb_api_key": args.set_tmdb_key.strip()})
        print(f"✅ Clave TMDB guardada permanentemente en {CONFIG_FILE}!")
        sys.exit(0)

    if not args.target:
        parser.print_help()
        sys.exit(1)
        
    run_faststream(args.target, args.port, args.tmdb_key, args.verbose)

if __name__ == "__main__":
    main()
