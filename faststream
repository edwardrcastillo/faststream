        async function performTMDBSearch() {{
            const query = document.getElementById('searchInput').value.trim();
            const year = document.getElementById('yearInput').value.trim();
            const container = document.getElementById('resultsContainer');
            container.innerHTML = '<div style="color:#38bdf8; text-align:center; padding:24px; font-weight:600;">🔍 Consultando base de datos cinematográfica en vivo...</div>';
            
            try {{
                const res = await fetch(`/api/search?q=${{encodeURIComponent(query)}}&year=${{encodeURIComponent(year)}}`);
                const results = await res.json();
                if (!results || !results.length) {{
                    container.innerHTML = `<div style="color:#ef4444; text-align:center; padding:20px; font-size:14px;">❌ No se encontraron coincidencias para "${{escapeHtml(query)}}".<br><span style="color:#94a3b8; font-size:12px;">Prueba buscando por su código de IMDb (ej: tt3495184) o su ID numérico de TMDB.</span></div>`;
                    return;
                }}
                
                let html = '';
                results.forEach(m => {{
                    const ext = "{os.path.splitext(meta['filename'])[1]}";
                    const cleanTitleSafe = m.title.replace(/[/\\\\?%*:|"<>.]/g, '').trim();
                    const jellyfinName = `${{cleanTitleSafe}} (${{m.year}}) [tmdbid-${{m.id}}]${{ext}}`;
                    const poster = m.poster_url ? `<img src="${{m.poster_url}}" class="result-poster">` : '<div class="result-poster" style="display:flex;align-items:center;justify-content:center;">🎬</div>';
                    
                    const safeEncTitle = encodeURIComponent(cleanTitleSafe);
                    const safeYear = encodeURIComponent(m.year || '');
                    
                    html += `
                    <div class="result-item">
                        ${{poster}}
                        <div class="result-details">
                            <div class="result-title">${{escapeHtml(m.title)}} <span style="color:#94a3b8; font-weight:normal;">(${{escapeHtml(m.year)}})</span> ⭐ ${{m.rating}}</div>
                            <div class="result-sub">TMDB ID: ${{m.id}} ${{m.imdb_id ? '| IMDb: ' + m.imdb_id : ''}} | Original: <i>${{escapeHtml(m.original_title)}}</i></div>
                            <div class="result-desc">${{escapeHtml(m.overview)}}</div>
                            <div class="jellyfin-suggestion">🏷️ Sugerencia Jellyfin: <b>${{escapeHtml(jellyfinName)}}</b></div>
                        </div>
                        <button class="apply-btn" id="btn-apply-${{m.id}}" onclick="applyRename('${{m.id}}', '${{safeEncTitle}}', '${{safeYear}}')">✅ Aplicar y Ver</button>
                    </div>`;
                }});
                container.innerHTML = html;
            }} catch(e) {{
                container.innerHTML = '<div style="color:#ef4444; text-align:center; padding:20px;">❌ Error de conexión al consultar metadatos.</div>';
            }}
        }}

        async function applyRename(tmdbId, encTitle, year) {{
            const btn = document.getElementById(`btn-apply-${{tmdbId}}`);
            if (btn) {{
                btn.disabled = true;
                btn.innerText = "⏳ Guardando...";
                btn.style.opacity = "0.7";
            }}
            try {{
                const res = await fetch('/api/rename?index={current_idx}', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{
                        tmdb_id: tmdbId,
                        title: decodeURIComponent(encTitle),
                        year: decodeURIComponent(year)
                    }})
                }});
                const data = await res.json();
                if (data.success) {{
                    // Transición directa al reproductor con los nuevos metadatos y poster aplicados
                    window.location.reload();
                }} else {{
                    alert("❌ Error al renombrar: " + data.error);
                    if (btn) {{
                        btn.disabled = false;
                        btn.innerText = "✅ Aplicar y Ver";
                        btn.style.opacity = "1";
                    }}
                }}
            }} catch(e) {{
                alert("❌ Error de red al aplicar renombrado.");
                if (btn) {{
                    btn.disabled = false;
                    btn.innerText = "✅ Aplicar y Ver";
                    btn.style.opacity = "1";
                }}
            }}
        }}

        async function remoteShutdown() {{
