    <script>
        const selectedTitles = {{}};

        function escapeHtml(str) {{
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }}

        function openSearchModal() {{
            document.getElementById('searchModal').style.display = 'flex';
            setTimeout(() => {{
                document.getElementById('searchInput').focus();
            }}, 50);
            performTMDBSearch();
        }}
        function closeSearchModal() {{
            document.getElementById('searchModal').style.display = 'none';
        }}

        function switchAudioTrack(streamId) {{
            const video = document.getElementById('playerVideo');
            if (!video) return;
            const curTime = video.currentTime;
            const isPaused = video.paused;
            const baseUrl = `/video?index={current_idx}`;
            const newSrc = streamId !== "" ? `${{baseUrl}}&audio=${{streamId}}` : baseUrl;
            
            const srcElem = document.getElementById('videoSource');
            if (srcElem) srcElem.src = newSrc;
            video.src = newSrc;
            
            video.addEventListener('loadedmetadata', function() {{
                video.currentTime = curTime;
                if (!isPaused) video.play().catch(()=>{{}});
            }}, {{ once: true }});
            video.load();
        }}

        function switchSubtitleTrack(val) {{
            const video = document.getElementById('playerVideo');
            if (!video || !video.textTracks) return;
            const trackIdx = parseInt(val);
            for (let i = 0; i < video.textTracks.length; i++) {{
                if (i === trackIdx) {{
                    video.textTracks[i].mode = 'showing';
                }} else {{
                    video.textTracks[i].mode = 'disabled';
                }}
            }}
        }}

        window.addEventListener('DOMContentLoaded', () => {{
            const video = document.getElementById('playerVideo');
            const subSelect = document.getElementById('subTrackSelect');
            if (video && video.textTracks && subSelect) {{
                for (let i = 0; i < video.textTracks.length; i++) {{
                    if (video.textTracks[i].mode === 'showing' || video.textTracks[i].default) {{
                        subSelect.value = i;
                        video.textTracks[i].mode = 'showing';
                        break;
                    }}
                }}
            }}
        }});

        function selectTitleVariant(itemId, chosenTitle, tmdbId, year) {{
            selectedTitles[itemId] = chosenTitle;
            const ext = "{os.path.splitext(meta['filename'])[1]}";
            const cleanTitleSafe = chosenTitle.replace(/[/\\\\?%*:|"<>.]/g, '').trim();
            const jellyfinName = `${{cleanTitleSafe}} (${{year}}) [tmdbid-${{tmdbId}}]${{ext}}`;
            
            const sugElem = document.getElementById(`sug-${{itemId}}`);
            if (sugElem) sugElem.innerHTML = `🏷️ Sugerencia Jellyfin: <b>${{escapeHtml(jellyfinName)}}</b>`;
            
            document.querySelectorAll(`.chip-${{itemId}}`).forEach(ch => {{
                if (ch.getAttribute('data-title') === chosenTitle) {{
                    ch.classList.add('active');
                }} else {{
                    ch.classList.remove('active');
                }}
            }});
        }}
        
        async function performTMDBSearch() {{
            const query = document.getElementById('searchInput').value.trim();
            const year = document.getElementById('yearInput').value.trim();
            const container = document.getElementById('resultsContainer');
            container.innerHTML = '<div style="color:#38bdf8; text-align:center; padding:24px; font-weight:600;">🔍 Consultando base de datos cinematográfica y traducciones en vivo...</div>';
            
            try {{
                const res = await fetch(`/api/search?q=${{encodeURIComponent(query)}}&year=${{encodeURIComponent(year)}}`);
                const results = await res.json();
                if (!results || !results.length) {{
                    container.innerHTML = `<div style="color:#ef4444; text-align:center; padding:20px; font-size:14px;">❌ No se encontraron coincidencias para "${{escapeHtml(query)}}".<br><span style="color:#94a3b8; font-size:12px;">Prueba buscando por su código de IMDb (ej: tt19851736), TMDB ID (ej: 973608) o limpiando el título.</span></div>`;
                    return;
                }}
                
                let html = '';
                results.forEach((m, idx) => {{
                    const itemId = `res-${{idx}}`;
                    selectedTitles[itemId] = m.title;
                    const ext = "{os.path.splitext(meta['filename'])[1]}";
                    const cleanTitleSafe = m.title.replace(/[/\\\\?%*:|"<>.]/g, '').trim();
                    const jellyfinName = `${{cleanTitleSafe}} (${{m.year}}) [tmdbid-${{m.id}}]${{ext}}`;
                    const poster = m.poster_url ? `<img src="${{m.poster_url}}" class="result-poster">` : '<div class="result-poster" style="display:flex;align-items:center;justify-content:center;">🎬</div>';
                    
                    let chipsHtml = '';
                    if (m.title_options && m.title_options.length > 1) {{
                        chipsHtml = '<div class="title-chips"><span style="color:#94a3b8; font-size:11px; align-self:center;">Opciones de idioma:</span>';
                        m.title_options.forEach(opt => {{
                            const isAct = opt.title === m.title ? 'active' : '';
                            const safeOptT = opt.title.replace(/'/g, "\\'");
                            chipsHtml += `<button class="chip chip-${{itemId}} ${{isAct}}" data-title="${{escapeHtml(opt.title)}}" onclick="selectTitleVariant('${{itemId}}', '${{escapeHtml(safeOptT)}}', '${{m.id}}', '${{escapeHtml(m.year || '')}}')">${{opt.lang}}: ${{escapeHtml(opt.title)}}</button>`;
                        }});
                        chipsHtml += '</div>';
                    }}

                    html += `
                    <div class="result-item">
                        ${{poster}}
                        <div class="result-details">
                            <div class="result-title">${{escapeHtml(m.title)}} <span style="color:#94a3b8; font-weight:normal;">(${{escapeHtml(m.year)}})</span> ⭐ ${{m.rating}}</div>
                            <div class="result-sub">TMDB ID: ${{m.id}} ${{m.imdb_id ? '| IMDb: ' + m.imdb_id : ''}} | Original: <i>${{escapeHtml(m.original_title)}}</i></div>
                            ${{chipsHtml}}
                            <div class="result-desc">${{escapeHtml(m.overview)}}</div>
                            <div class="jellyfin-suggestion" id="sug-${{itemId}}">🏷️ Sugerencia Jellyfin: <b>${{escapeHtml(jellyfinName)}}</b></div>
                        </div>
                        <button class="apply-btn" id="btn-apply-${{itemId}}" onclick="applySelectedRename('${{itemId}}', '${{m.id}}', '${{encodeURIComponent(m.year || '')}}')">✅ Aplicar y Ver</button>
                    </div>`;
                }});
                container.innerHTML = html;
            }} catch(e) {{
                container.innerHTML = '<div style="color:#ef4444; text-align:center; padding:20px;">❌ Error de conexión al consultar metadatos.</div>';
            }}
        }}

        async function applySelectedRename(itemId, tmdbId, year) {{
            const chosenTitle = selectedTitles[itemId] || "";
            const btn = document.getElementById(`btn-apply-${{itemId}}`);
            if (btn) {{
                btn.disabled = true;
                btn.innerText = "⏳ Guardando...";
                btn.style.opacity = "0.7";
            }}
            try {{
                const res = await fetch('/api/rename?index={current_idx}', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{
                        tmdb_id: tmdbId,
                        title: chosenTitle,
                        year: decodeURIComponent(year)
                    }})
                }});
                const data = await res.json();
                if (data.success) {{
                    window.location.reload();
