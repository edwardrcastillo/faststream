        }}

        async function remoteShutdown() {{
            if (!confirm("¿Deseas detener el servidor FastStream y liberar el puerto?")) return;
            try {{
                await fetch('/api/shutdown', {{ method: 'POST' }});
            }} catch(e) {{}}
            document.body.innerHTML = `
