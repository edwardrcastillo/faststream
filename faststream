        function closeSearchModal() {{
            document.getElementById('searchModal').style.display = 'none';
        }}
        
        async function performTMDBSearch() {{
            const query = document.getElementById('searchInput').value.trim();
            const year = document.getElementById('yearInput').value.trim();
            const container = document.getElementById('resultsContainer');
            container.innerHTML = '<div style="color:#94a3b8; text-align:center; padding:20px;">🔍 Buscando en TMDB...</div>';
            
            try {{
                const res = await fetch(`/api/search?q=${{encodeURIComponent(query)}}&year=${{encodeURIComponent(year)}}`);
                const results = await res.json();
                if (!results.length) {{
                    container.innerHTML = '<div style="color:#ef4444; text-align:center; padding:20px;">❌ No se encontraron resultados en TMDB. Intenta con otro término.</div>';
                    return;
                }}
                
                let html = '';
                results.forEach(m => {{
                    const ext = "{os.path.splitext(meta['filename'])[1]}";
                    const cleanTitleSafe = m.title.replace(/[/\\\\?%*:|"<>]/g, '').trim();
                    const jellyfinName = `${{cleanTitleSafe}} (${{m.year}}) [tmdbid-${{m.id}}]${{ext}}`;
                    const poster = m.poster_url ? `<img src="${{m.poster_url}}" class="result-poster">` : '<div class="result-poster" style="display:flex;align-items:center;justify-content:center;">🎬</div>';
                    
                    html += `
                    <div class="result-item">
                        ${{poster}}
                        <div class="result-details">
                            <div class="result-title">${{m.title}} <span style="color:#94a3b8; font-weight:normal;">(${{m.year}})</span> ⭐ ${{m.rating}}</div>
                            <div class="result-sub">ID TMDB: ${{m.id}} | Original: <i>${{m.original_title}}</i></div>
                            <div class="result-desc">${{m.overview}}</div>
                            <div class="jellyfin-suggestion">🏷️ Sugerencia Jellyfin: <b>${{jellyfinName}}</b></div>
                        </div>
                        <button class="apply-btn" onclick="applyRename('${{m.id}}', '${{encodeURIComponent(cleanTitleSafe)}}', '${{m.year}}')">✅ Aplicar y Renombrar</button>
                    </div>`;
                }});
                container.innerHTML = html;
            }} catch(e) {{
                container.innerHTML = '<div style="color:#ef4444; text-align:center; padding:20px;">❌ Error de conexión al consultar TMDB.</div>';
            }}
        }}

        async function applyRename(tmdbId, encTitle, year) {{
            if (!confirm("¿Deseas renombrar físicamente este archivo al estándar Jellyfin y actualizar los metadatos?")) return;
            try {{
                const res = await fetch('/api/rename', {{
                    method: 'POST',
                    headers: {{ 'Content-Type': 'application/json' }},
                    body: JSON.stringify({{
                        tmdb_id: tmdbId,
                        title: decodeURIComponent(encTitle),
                        year: year
                    }})
                }});
                const data = await res.json();
                if (data.success) {{
                    alert("✅ Archivo renombrado exitosamente a: " + data.new_filename);
                    window.location.reload();
                }} else {{
                    alert("❌ Error: " + data.error);
                }}
            }} catch(e) {{
                alert("❌ Error al solicitar el renombrado.");
            }}
        }}
    </script>
</body>
</html>"""

def run_faststream(target, port=8090, api_key=None):
    abs_target = os.path.abspath(target)
    if not os.path.exists(abs_target):
        print(f"❌ Error: La ruta '{target}' no existe.")
        sys.exit(1)
        
    is_dir = os.path.isdir(abs_target)
    file_list = []
    current_file = abs_target
    
    if is_dir:
        for root, _, files in os.walk(abs_target):
            for f in sorted(files):
                ext = os.path.splitext(f)[1].lower()
                if ext in VIDEO_EXTS and not f.startswith('.'):
                    file_list.append(os.path.join(root, f))
        if not file_list:
            print(f"❌ No se encontraron archivos de video en '{target}'.")
            sys.exit(1)
        current_file = file_list[0]
        meta = get_file_metadata(current_file, api_key)
    else:
        print("🔍 Consultando metadatos iniciales...")
        meta = get_file_metadata(abs_target, api_key)

    class FastStreamHandler(http.server.BaseHTTPRequestHandler):
        def do_HEAD(self):
            if self.path.startswith("/video"):
                self.send_response(200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Accept-Ranges", "bytes")
                self.end_headers()
            else:
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()

        def do_GET(self):
            nonlocal current_file, abs_target, meta
            parsed = urllib.parse.urlparse(self.path)
            
            # API DE BÚSQUEDA TMDB
            if parsed.path == "/api/search":
                qs = urllib.parse.parse_qs(parsed.query)
                q = qs.get("q", [""])[0]
                y = qs.get("year", [""])[0]
                results = query_tmdb_search(q, y, api_key)
                self.send_response(200)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.end_headers()
                self.wfile.write(json.dumps(results, ensure_ascii=False).encode("utf-8"))
                return

            if parsed.path == "/" or parsed.path == "/index.html":
                meta = get_file_metadata(current_file, api_key)
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                html = generate_player_html(current_file, meta, is_dir=is_dir, file_list=file_list)
                self.wfile.write(html.encode("utf-8"))
                return
                
            if parsed.path == "/play":
                query = urllib.parse.parse_qs(parsed.query)
                idx = int(query.get("index", ["0"])[0])
                if 0 <= idx < len(file_list):
                    current_file = file_list[idx]
                    meta = get_file_metadata(current_file, api_key)
                    self.send_response(200)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.end_headers()
                    html = generate_player_html(current_file, meta, is_dir=False)
                    self.wfile.write(html.encode("utf-8"))
                return

            if parsed.path == "/video":
                if not os.path.exists(current_file):
                    self.send_error(404, "Archivo no encontrado")
                    return
                    
                file_sz = os.path.getsize(current_file)
                range_header = self.headers.get("Range")
                
                if range_header:
                    try:
                        rng = range_header.strip().split("=")[1].split("-")
                        start = int(rng[0])
                        end = int(rng[1]) if rng[1] else file_sz - 1
                    except:
                        start, end = 0, file_sz - 1
                        
                    chunk_sz = end - start + 1
                    self.send_response(206)
                    self.send_header("Content-Type", "video/mp4")
                    self.send_header("Accept-Ranges", "bytes")
                    self.send_header("Content-Range", f"bytes {start}-{end}/{file_sz}")
                    self.send_header("Content-Length", str(chunk_sz))
                    self.end_headers()
                    
                    with open(current_file, "rb") as f:
                        f.seek(start)
                        rem = chunk_sz
                        while rem > 0:
                            buf = f.read(min(rem, 64*1024))
                            if not buf: break
                            self.wfile.write(buf)
                            rem -= len(buf)
                else:
                    self.send_response(200)
                    self.send_header("Content-Type", "video/mp4")
                    self.send_header("Accept-Ranges", "bytes")
                    self.send_header("Content-Length", str(file_sz))
                    self.end_headers()
                    with open(current_file, "rb") as f:
                        while True:
                            buf = f.read(64*1024)
                            if not buf: break
                            self.wfile.write(buf)
                return

            self.send_error(404)

        def do_POST(self):
            nonlocal current_file, abs_target, meta
            parsed = urllib.parse.urlparse(self.path)
            
            # API DE RENOMBRADO JELLYFIN
            if parsed.path == "/api/rename":
                length = int(self.headers.get('Content-Length', 0))
                body = self.rfile.read(length)
                try:
                    payload = json.loads(body.decode('utf-8'))
                    tmdb_id = payload.get('tmdb_id')
                    title = payload.get('title', '').strip()
                    year = payload.get('year', '').strip()
                    
                    clean_t = re.sub(r'[/\\\\?%*:|"<>.]', '', title).strip()
                    ext = os.path.splitext(current_file)[1]
                    parent_dir = os.path.dirname(current_file)
                    
                    new_filename = f"{clean_t} ({year}) [tmdbid-{tmdb_id}]{ext}"
                    new_full_path = os.path.join(parent_dir, new_filename)
                    
                    print(f"\n🏷️ Renombrando archivo físico a estándar Jellyfin:")
                    print(f"   Origen:  {current_file}")
                    print(f"   Destino: {new_full_path}")
                    
                    os.rename(current_file, new_full_path)
                    current_file = new_full_path
                    if not is_dir:
                        abs_target = new_full_path
                    meta = get_file_metadata(current_file, api_key)
                    
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json; charset=utf-8")
                    self.end_headers()
                    self.wfile.write(json.dumps({
                        "success": True,
                        "new_filename": new_filename,
                        "new_path": new_full_path
                    }).encode('utf-8'))
                except Exception as e:
                    self.send_response(500)
                    self.send_header("Content-Type", "application/json; charset=utf-8")
                    self.end_headers()
                    self.wfile.write(json.dumps({"success": False, "error": str(e)}).encode('utf-8'))
                return

            self.send_error(404)

    class ReusableTCPServer(socketserver.TCPServer):
        allow_reuse_address = True

    lan_ip = get_lan_ip()
    stream_url = f"http://{lan_ip}:{port}/"
    
    print("\n" + "="*70)
    print(f"⚡ FASTSTREAM v1.4 - STREAMING Y AUDITORÍA DE MEDIOS")
    print("="*70)
    print(f"🎬 Título:   {meta['title']} ({meta.get('year') or 'N/A'})")
    print(f"📂 Archivo:  {abs_target}")
    print(f"🌐 URL Web:  \033[1;32m{stream_url}\033[0m")
    if meta.get("poster_url"):
        print(f"🖼️  Carátula: {meta['poster_url']}")
    print("="*70)
    print("💡 Presiona Ctrl + C para detener el servidor en cualquier momento.\n")
    
    try:
        with ReusableTCPServer(("0.0.0.0", port), FastStreamHandler) as httpd:
            httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n🛑 Servidor FastStream detenido correctamente.")
        sys.exit(0)

def main():
    parser = argparse.ArgumentParser(description="⚡ FastStream - Transmite cualquier video o carpeta por HTTP al instante en tu red local.")
    parser.add_argument("target", nargs="?", help="Ruta al archivo de video o carpeta a transmitir.")
    parser.add_argument("-p", "--port", type=int, default=8090, help="Puerto HTTP (por defecto: 8090).")
    parser.add_argument("--tmdb-key", help="Clave de API de TheMovieDB a usar.")
    parser.add_argument("--set-tmdb-key", help="Guardar tu clave de API de TMDB en ~/.config/faststream/config.json permanentemente.")
    args = parser.parse_args()
    
    if args.set_tmdb_key:
        save_config({"tmdb_api_key": args.set_tmdb_key.strip()})
        print(f"✅ Clave TMDB guardada permanentemente en {CONFIG_FILE}!")
        sys.exit(0)

    if not args.target:
        parser.print_help()
        sys.exit(1)
        
    run_faststream(args.target, args.port, args.tmdb_key)

if __name__ == "__main__":
    main()
