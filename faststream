# Terminal Live Progress Bar Helper
def print_progress_bar(current, total, title="", width=30):
    pct = (current / total) * 100 if total > 0 else 100
    filled = int(width * current // total) if total > 0 else width
    bar = "█" * filled + "░" * (width - filled)
    
    safe_title = (title[:30] + '..') if len(title) > 32 else title
    sys.stdout.write(f"\r  🔍 [{bar}] {current}/{total} ({pct:.0f}%) | {safe_title:<32}")
    sys.stdout.flush()
    if current >= total:
        sys.stdout.write("\n")
        sys.stdout.flush()

# Audio / Video Metadata Probing
def parse_mp4_atoms_duration(file_path):
    try:
        with open(file_path, 'rb') as f:
            while True:
                header = f.read(8)
                if len(header) < 8: break
                size, atom_type = struct.unpack('>I4s', header)
                if size == 0: break
                if size == 1:
                    size = struct.unpack('>Q', f.read(8))[0] - 16
                else:
                    size -= 8
                if atom_type == b'moov':
                    moov_data = f.read(size)
                    pos = moov_data.find(b'mvhd')
                    if pos != -1:
                        mvhd = moov_data[pos+8:pos+size]
                        version = mvhd[0]
                        if version == 0:
                            timescale, duration = struct.unpack('>II', mvhd[12:20])
                        else:
                            timescale, duration = struct.unpack('>IQ', mvhd[20:32])
                        if timescale > 0:
                            return duration / timescale
                    break
                else:
                    f.seek(size, 1)
    except Exception:
        pass
    return None

def clean_movie_title(fname):
    name = os.path.splitext(fname)[0]
    tmdb_match = re.search(r'\[tmdbid-(\d+)\]', name)
    tmdb_id = int(tmdb_match.group(1)) if tmdb_match else None
    
    y_match = re.search(r'\((\d{4})\)', name)
    year = int(y_match.group(1)) if y_match else None
    
    clean = re.sub(r'\[.*?\]|\(.*?\)', '', name)
    clean = re.sub(r'1080p|720p|480p|x264|x265|hevc|bluray|dvdrip|web-dl|webrip|latino|dual|castellano|h264|aac', '', clean, flags=re.I)
    clean = re.sub(r'[-_.]', ' ', clean).strip()
    clean = re.sub(r'\s+', ' ', clean)
    return clean, year, tmdb_id

def has_non_latin_chars(text):
    if not text: return False
    return bool(re.search(r'[\uac00-\ud7a3\u3040-\u30ff\u4e00-\u9fff\u0400-\u04FF\u0600-\u06FF]', text))

def fetch_tmdb_translations_and_titles(media_id, media_type="movie", api_key=None):
    key = get_tmdb_api_key(api_key)
    url = f"https://api.themoviedb.org/3/{media_type}/{media_id}/translations?api_key={key}"
    es_title = None
    en_title = None
    es_overview = None
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'FastStream/2.0'})
        with urllib.request.urlopen(req, timeout=3) as r:
            data = json.loads(r.read().decode())
            for tr in data.get('translations', []):
                iso = tr.get('iso_639_1')
                t_val = tr.get('data', {}).get('title') or tr.get('data', {}).get('name')
                o_val = tr.get('data', {}).get('overview')
                if t_val:
                    if iso == 'es' and not es_title:
                        es_title = t_val
                        if o_val: es_overview = o_val
                    elif iso == 'en' and not en_title:
                        en_title = t_val
    except Exception:
        pass
    return es_title, en_title, es_overview

def process_raw_tmdb_item(m, media_type="movie", api_key=None):
    raw_title = m.get("title") or m.get("name") or ""
    orig_title = m.get("original_title") or m.get("original_name") or raw_title
    overview = m.get("overview") or "Sin sinopsis disponible."
    
    es_t, en_t, es_ov = fetch_tmdb_translations_and_titles(m["id"], media_type, api_key)
    
    title_options = []
    if es_t: title_options.append({"lang": "Español", "title": es_t})
    if en_t and en_t != es_t: title_options.append({"lang": "Inglés", "title": en_t})
    if orig_title and orig_title not in (es_t, en_t): title_options.append({"lang": "Original", "title": orig_title})
    if raw_title and raw_title not in (es_t, en_t, orig_title): title_options.append({"lang": "Alternativo", "title": raw_title})
    
    if es_t:
        primary_title = es_t
        if es_ov: overview = es_ov
    elif not has_non_latin_chars(raw_title) and raw_title:
        primary_title = raw_title
    elif en_t:
        primary_title = en_t
    elif not has_non_latin_chars(orig_title) and orig_title:
        primary_title = orig_title
    else:
        primary_title = raw_title or orig_title

    return {
        "id": m["id"],
        "media_type": media_type,
        "title": primary_title,
        "original_title": orig_title,
        "title_options": title_options,
        "year": (m.get("release_date") or m.get("first_air_date") or "")[:4],
        "overview": overview,
        "poster_url": f"https://image.tmdb.org/t/p/w500{m['poster_path']}" if m.get("poster_path") else None,
        "backdrop_url": f"https://image.tmdb.org/t/p/w1280{m['backdrop_path']}" if m.get("backdrop_path") else None,
        "rating": round(m.get("vote_average", 0), 1),
        "imdb_id": m.get("imdb_id")
    }

def query_tmdb_search(query, year=None, api_key=None):
    key = get_tmdb_api_key(api_key)
    query_str = query.strip()
    cache_key = f"{normalize_text(query_str)}_{year}"
    
    if cache_key in TMDB_MEMORY_CACHE:
        return TMDB_MEMORY_CACHE[cache_key]

    # Extraer TMDB ID de URL directa (ej: https://www.themoviedb.org/movie/454458-uglydolls)
    tmdb_url_match = re.search(r'themoviedb\.org/(movie|tv)/(\d+)', query_str, re.I)
    if tmdb_url_match:
        m_type = tmdb_url_match.group(1).lower()
        t_id = tmdb_url_match.group(2)
        url = f"https://api.themoviedb.org/3/{m_type}/{t_id}?api_key={key}&language=es-MX"
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'FastStream/2.0'})
            with urllib.request.urlopen(req, timeout=4) as resp:
                m = json.loads(resp.read().decode())
                if m.get("id"):
                    res = [process_raw_tmdb_item(m, m_type, api_key)]
                    TMDB_MEMORY_CACHE[cache_key] = res
                    return res
        except Exception:
            pass

    # 1. Búsqueda por IMDb ID (ej: tt19851736 o https://www.imdb.com/title/tt19851736/)
    imdb_match = re.search(r'(tt\d{7,9})', query_str, re.I)
    if imdb_match:
        imdb_id = imdb_match.group(1)
        url = f"https://api.themoviedb.org/3/find/{imdb_id}?api_key={key}&external_source=imdb_id&language=es-MX"
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'FastStream/2.0'})
            with urllib.request.urlopen(req, timeout=4) as resp:
                data = json.loads(resp.read().decode())
                results = []
                for m in data.get('movie_results', []):
                    results.append(process_raw_tmdb_item(m, "movie", api_key))
                for s in data.get('tv_results', []):
                    results.append(process_raw_tmdb_item(s, "tv", api_key))
                for ep in data.get('tv_episode_results', []):
                    show_id = ep.get('show_id')
                    show_name = "Serie"
                    if show_id:
                        try:
                            s_url = f"https://api.themoviedb.org/3/tv/{show_id}?api_key={key}&language=es-MX"
                            s_req = urllib.request.Request(s_url, headers={'User-Agent': 'FastStream/2.0'})
                            with urllib.request.urlopen(s_req, timeout=3) as s_resp:
                                s_data = json.loads(s_resp.read().decode())
                                show_name = s_data.get('name') or s_data.get('original_name') or "Serie"
                        except Exception:
                            pass
                    
                    s_num = ep.get('season_number', 1)
                    e_num = ep.get('episode_number', 1)
                    ep_t = ep.get('name') or f"Episodio {e_num}"
                    full_ep_name = f"{show_name} - S{s_num:02d}E{e_num:02d} - {ep_t}"
                    
                    results.append({
                        "id": ep["id"],
                        "media_type": "tv_episode",
                        "title": full_ep_name,
                        "original_title": ep.get('name', ''),
                        "title_options": [{"lang": "Episodio Jellyfin", "title": full_ep_name}],
                        "year": (ep.get("air_date") or "")[:4],
                        "overview": ep.get("overview") or f"Episodio {e_num} de la temporada {s_num} de {show_name}.",
                        "poster_url": f"https://image.tmdb.org/t/p/w500{ep['still_path']}" if ep.get("still_path") else None,
                        "backdrop_url": f"https://image.tmdb.org/t/p/w1280{ep['still_path']}" if ep.get("still_path") else None,
                        "rating": round(ep.get("vote_average", 0), 1),
                        "imdb_id": imdb_id
                    })

                if results:
                    TMDB_MEMORY_CACHE[cache_key] = results
                    return results
        except Exception:
            pass

    # 2. Búsqueda por TMDB ID directo
    if query_str.isdigit():
        for m_type in ["movie", "tv"]:
            url = f"https://api.themoviedb.org/3/{m_type}/{query_str}?api_key={key}&language=es-MX"
            try:
                req = urllib.request.Request(url, headers={'User-Agent': 'FastStream/2.0'})
                with urllib.request.urlopen(req, timeout=3) as resp:
                    m = json.loads(resp.read().decode())
                    if m.get("id"):
                        res = [process_raw_tmdb_item(m, m_type, api_key)]
                        TMDB_MEMORY_CACHE[cache_key] = res
                        return res
            except Exception:
                pass

    # 3. Búsqueda inteligente por texto con normalización de acentos y multi-search
    clean_text = query_str
    if query_str.startswith("http"):
        clean_text = query_str.split("/")[-1].replace("-", " ").replace("_", " ").strip()
        if not clean_text or clean_text.isdigit() or clean_text.startswith("tt"):
            clean_text = query_str.split("/")[-2].replace("-", " ").replace("_", " ").strip()

    search_attempts = [clean_text]
    
    # Variante normalizada sin acentos (dragón -> dragon)
    norm_clean = normalize_text(clean_text)
    if norm_clean != clean_text.lower():
        search_attempts.append(norm_clean)

    # Descartar stopwords y generar variantes reversibles
    stopwords = {'el', 'la', 'los', 'las', 'un', 'una', 'unos', 'unas', 'de', 'del', 'a', 'en', 'para', 'por', 'con', 'the', 'a', 'an', 'of', 'in', 'on', 'and', 'isla'}
    words = [w for w in re.split(r'[\s\-_\.:,]+', norm_clean) if w not in stopwords and len(w) > 1]
    if len(words) >= 2:
        search_attempts.append(' '.join(words))
        search_attempts.append(f"{words[-1]} {words[0]}")

    for attempt in search_attempts:
        if not attempt: continue
        enc_q = urllib.parse.quote(attempt)
        for lang in ["es-MX", "en-US"]:
            url = f"https://api.themoviedb.org/3/search/multi?api_key={key}&query={enc_q}&language={lang}"
            if year: url += f"&year={year}"
            
            try:
                req = urllib.request.Request(url, headers={'User-Agent': 'FastStream/2.0'})
                with urllib.request.urlopen(req, timeout=4) as resp:
                    data = json.loads(resp.read().decode())
                    raw_res = data.get('results', [])
                    if raw_res:
                        results = []
                        for m in raw_res[:8]:
                            media_type = m.get('media_type', 'movie')
                            if media_type in ('movie', 'tv'):
                                results.append(process_raw_tmdb_item(m, media_type, api_key))
                        if results:
                            TMDB_MEMORY_CACHE[cache_key] = results
                            return results
            except Exception:
                pass

    return []

def get_file_metadata(file_path, api_key=None):
    filename = os.path.basename(file_path)
    clean_t, yr, tmdb_id = clean_movie_title(filename)
    
    duration_str = "HD"
    res_str = "HD"
    codec_str = "H.264"
    audio_str = "Estéreo"
    
    audio_tracks = []
    subtitle_tracks = []
    
    try:
        cmd = ['ffprobe', '-v', 'error', '-show_streams', '-show_format', '-of', 'json', file_path]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            dur = float(data.get('format', {}).get('duration', 0))
            if dur > 0:
                mins = int(dur // 60)
                duration_str = f"{mins // 60}h {mins % 60}m" if mins >= 60 else f"{mins} min"
                
            for st in data.get('streams', []):
                stype = st.get('codec_type')
                sidx = st.get('index')
                stags = st.get('tags') or {}
                disp = st.get('disposition') or {}
                
                lang = (stags.get('language') or 'und').lower()
                title_tag = stags.get('title') or stags.get('name') or ''
                
                if stype == 'video':
                    if st.get('width'):
                        w = st.get('width')
                        h = st.get('height')
                        res_str = f"{w}x{h}" if w else "HD"
                        codec_str = st.get('codec_name', 'H.264').upper()
                        
                elif stype == 'audio':
                    ch = st.get('channels', 2)
                    ch_str = "5.1 Surround" if ch >= 6 else ("Estéreo" if ch == 2 else "Mono")
                    if not audio_str or audio_str == "Estéreo":
                        audio_str = ch_str
                        
                    if title_tag:
                        human_title = title_tag
                    elif lang in ('spa', 'es', 'es-mx', 'es-es', 'es-419'):
                        human_title = "Español (Latino)" if "lat" in title_tag.lower() else "Español"
                    elif lang in ('jpn', 'ja'):
                        human_title = "Japonés (Original)"
                    elif lang in ('eng', 'en'):
                        human_title = "Inglés"
                    elif lang in ('fra', 'fr'):
                        human_title = "Francés"
                    elif lang in ('deu', 'ger', 'de'):
                        human_title = "Alemán"
                    elif lang in ('ita', 'it'):
                        human_title = "Italiano"
                    elif lang in ('por', 'pt'):
                        human_title = "Portugués"
                    else:
                        human_title = f"Pista Audio {len(audio_tracks)+1} ({lang.upper()})"
                        
                    human_title += f" • {ch_str}"
                    audio_tracks.append({
                        "index": len(audio_tracks),
                        "stream_id": sidx,
                        "language": lang,
                        "title": human_title,
                        "channels": ch,
                        "codec": st.get('codec_name', '').upper(),
                        "is_default": disp.get('default', 0) == 1
                    })
                    
                elif stype == 'subtitle':
                    is_forced = disp.get('forced', 0) == 1 or 'forced' in title_tag.lower() or 'forzado' in title_tag.lower()
                    if title_tag:
                        human_sub = title_tag
                    elif lang in ('spa', 'es', 'es-mx', 'es-es', 'es-419'):
                        human_sub = "Español (Forzado)" if is_forced else "Español (Completo)"
                    elif lang in ('eng', 'en'):
                        human_sub = "Inglés (Forzado)" if is_forced else "Inglés"
                    elif lang in ('jpn', 'ja'):
                        human_sub = "Japonés"
                    else:
                        human_sub = f"Subtítulo {len(subtitle_tracks)+1} ({lang.upper()})"
                        
                    if is_forced and "forzado" not in human_sub.lower() and "forced" not in human_sub.lower():
                        human_sub += " (Forzado)"
                        
                    subtitle_tracks.append({
                        "index": len(subtitle_tracks),
                        "stream_id": sidx,
                        "language": lang if lang != 'und' else 'es',
                        "title": human_sub,
                        "forced": is_forced,
                        "codec": st.get('codec_name', ''),
                        "is_default": disp.get('default', 0) == 1
                    })
    except Exception:
        atom_dur = parse_mp4_atoms_duration(file_path)
        if atom_dur:
            mins = int(atom_dur // 60)
            duration_str = f"{mins // 60}h {mins % 60}m" if mins >= 60 else f"{mins} min"

    # External Subtitle Search
    try:
        parent_d = os.path.dirname(file_path)
        base_no_ext = os.path.splitext(filename)[0]
        if os.path.exists(parent_d):
            for ext_f in os.listdir(parent_d):
                if ext_f.lower().endswith(('.srt', '.vtt')) and ext_f.startswith(base_no_ext):
                    ext_path = os.path.join(parent_d, ext_f)
                    ext_lang = 'es'
                    if '.en.' in ext_f.lower() or '.eng.' in ext_f.lower(): ext_lang = 'en'
                    subtitle_tracks.append({
                        "index": len(subtitle_tracks),
                        "stream_id": f"ext:{ext_f}",
                        "language": ext_lang,
                        "title": f"Externo: {ext_f}",
                        "forced": 'forced' in ext_f.lower() or 'forzado' in ext_f.lower(),
                        "codec": "srt",
                        "is_external": True,
                        "ext_path": ext_path,
                        "is_default": False
                    })
    except Exception:
        pass

    try:
        size_bytes = os.path.getsize(file_path)
        size_mb = f"{size_bytes / (1024*1024):.1f} MB" if size_bytes < 1024*1024*1024 else f"{size_bytes / (1024*1024*1024):.2f} GB"
    except Exception:
        size_mb = "N/A"

    meta = {
        "filename": filename,
        "clean_title": clean_t,
        "title": clean_t,
        "year": yr,
        "tmdb_id": tmdb_id,
        "description": "Video listo para streaming instantáneo con FastStream.",
        "poster_url": None,
        "backdrop_url": None,
        "rating": None,
        "duration": duration_str,
        "resolution": res_str,
        "codec": codec_str,
        "audio": audio_str,
        "size_mb": size_mb,
        "audio_tracks": audio_tracks,
        "subtitle_tracks": subtitle_tracks
    }

    # TMDB Search
    search_q = str(tmdb_id) if tmdb_id else clean_t
    results = query_tmdb_search(search_q, yr, api_key)
    if results:
        best = results[0]
        meta["title"] = best["title"]
        meta["tmdb_id"] = best["id"]
        if best.get("year"): meta["year"] = best["year"]
        if best.get("overview"): meta["description"] = best["overview"]
        if best.get("poster_url"): meta["poster_url"] = best["poster_url"]
        if best.get("backdrop_url"): meta["backdrop_url"] = best["backdrop_url"]
        if best.get("rating"): meta["rating"] = best["rating"]

    return meta

