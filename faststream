import sys, os, socket, http.server, socketserver, argparse, urllib.parse, json, subprocess

def get_lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def print_qr_terminal(url):
    try:
        # Si qrencode está instalado
        res = subprocess.run(["qrencode", "-t", "UTF8", url], capture_output=True, text=True)
        if res.returncode == 0:
            print("\n📱 Escanea con tu teléfono o tablet para abrir al instante:\n")
            print(res.stdout)
    except Exception:
        pass

VIDEO_EXTS = {'.mp4', '.mkv', '.avi', '.mov', '.ts', '.m4v', '.webm'}

def get_file_metadata(file_path):
    cmd = ['ffprobe', '-v', 'error', '-show_format', '-show_streams', '-of', 'json', file_path]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            fmt = data.get('format', {})
            duration_sec = float(fmt.get('duration', 0))
            tags = fmt.get('tags', {})
            title = tags.get('title', os.path.splitext(os.path.basename(file_path))[0])
            
            v_stream = next((s for s in data.get('streams', []) if s.get('codec_type') == 'video'), None)
            res_str = f"{v_stream.get('width')}x{v_stream.get('height')}" if v_stream else "N/A"
            v_codec = v_stream.get('codec_name', 'N/A') if v_stream else "N/A"
            
            a_streams = [s for s in data.get('streams', []) if s.get('codec_type') == 'audio']
            a_summary = ", ".join([f"{a.get('tags', {}).get('language', 'und')}({a.get('codec_name')})" for a in a_streams])
            
            return {
                'title': title,
                'duration': f"{int(duration_sec // 60)} min {int(duration_sec % 60)} seg" if duration_sec else "N/A",
                'resolution': res_str,
                'codec': v_codec,
                'audio': a_summary or "Stereo",
                'size_mb': f"{os.path.getsize(file_path)/(1024*1024):.1f} MB",
                'description': tags.get('description') or tags.get('comment') or ""
            }
    except Exception:
        pass
    
    return {
        'title': os.path.splitext(os.path.basename(file_path))[0],
        'duration': "N/A",
        'resolution': "N/A",
        'codec': "N/A",
        'audio': "N/A",
        'size_mb': f"{os.path.getsize(file_path)/(1024*1024):.1f} MB",
        'description': ""
    }

